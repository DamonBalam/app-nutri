# Normalize line endings: LF by default, force CRLF on Windows-only scripts
* text=auto eol=lf

*.sh    text eol=lf
gradlew text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat as binary (no line-ending conversion, no diff noise)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.keystore binary
*.jks      binary
*.aab      binary
*.apk      binary
*.zip      binary
*.gz       binary
